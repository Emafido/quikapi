# Groq API Key (Required for AI Schema Generation)
# Get a free key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model (Optional, defaults to openai/gpt-oss-20b)
# Options: openai/gpt-oss-20b, openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-20b

# Base URL (Optional, defaults to request origin or http://localhost:3000)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
