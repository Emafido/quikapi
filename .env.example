# Groq API Key (Required for AI Schema Generation)
# Get a free key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model (Optional, defaults to llama-3.2-3b-preview with automatic fallbacks)
# Options: llama-3.2-3b-preview, openai/gpt-oss-20b, llama-3.2-1b-preview
GROQ_MODEL=llama-3.2-3b-preview

# Base URL (Optional, defaults to request origin or http://localhost:3000)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
